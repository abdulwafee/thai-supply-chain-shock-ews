# Copy this file to .env and fill in real values. .env is git-ignored — never
# commit it. No secrets currently exist for this project (all confirmed data
# sources in docs/data_source_inventory.md are public/no-auth), but this file
# is kept ready for the day an API key (e.g. a registered BOT API key) is
# needed.

# Absolute path to the project root on this machine. Required by
# configs/data.yaml's project_root_env_var setting — the codebase never
# hard-codes an absolute path itself.
THAI_SUPPLY_CHAIN_EWS_ROOT=/absolute/path/to/thai-supply-chain-ews

# Placeholder for a future BOT API key, if the new portal
# (https://portal.api.bot.or.th/) turns out to require one. Leave unset until
# actually needed — see docs/data_source_inventory.md row 15.
# BOT_API_KEY=
